# Build configuration is read from the process environment.
# Set these in your shell or hosting build settings (see README).
# Copying this file alone does not enable production or analytics.
SITE_ENV=preview
SITE_ORIGIN=https://dmplay.kalam.trade
# Opt in only for the authorized production release. Previews remain excluded.
SITE_INDEXABLE=false
# Optional measurement: disabled until the owner configures the property and consent.
ANALYTICS_ENABLED=false
GA4_MEASUREMENT_ID=
ANALYTICS_CONSENT_MODE=unconfigured
# Public values only. Never put account credentials in these fields.
SEARCH_CONSOLE_VERIFICATION_TOKEN=
CONTACT_EMAIL=
COURSE_INFO_URL=
# Disable Wrangler CLI usage metrics in local/hosted build environments.
WRANGLER_SEND_METRICS=false

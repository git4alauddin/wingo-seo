---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const samples = [
  { size: 20, small: 12, big: 8, percentage: 60 },
  { size: 2000, small: 1016, big: 984, percentage: 50.8 },
];
---
<figure class:list={['sample-comparison', { compact }]}>
  <div class="figure-topline"><span class="eyebrow">A question of sample size</span><span class="pill">Illustrative data</span></div>
  <div class="sample-cards">{samples.map(sample => <div class="sample-card"><div class="sample-heading"><strong>{sample.size.toLocaleString('en-US')}</strong><span>draws</span></div><div class="sample-bar" aria-hidden="true"><span style={`width:${sample.percentage}%`}></span></div><dl class="sample-values"><div><dt><span class="size-tag small">Small</span></dt><dd>{sample.small.toLocaleString('en-US')} <span>({sample.percentage}%)</span></dd></div><div><dt><span class="size-tag big">Big</span></dt><dd>{sample.big.toLocaleString('en-US')} <span>({100 - sample.percentage}%)</span></dd></div></dl></div>)}</div>
  <figcaption>Constructed examples under a 50/50 model. Larger samples often have smaller relative gaps, but every new sample can vary.</figcaption>
</figure>

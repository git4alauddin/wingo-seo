---
interface Props { footer?: boolean }
const { footer = false } = Astro.props;
---
<a class:list={['brand', 'brand-image', { 'footer-brand': footer }]} href="/" aria-label="WinGo Learning Lab home">
  <img src="/images/dmplay-logo.png" width="260" height="113" alt="DmPlay" decoding="async" />
  <span class="brand-sub">learning lab</span>
</a>

<style>
  .brand-image { flex:none; flex-direction:column; align-items:flex-start; gap:0; }
  .brand-image img { width:145px; height:auto; object-fit:contain; }
  .brand-image .brand-sub { margin:0 0 0 3px; letter-spacing:.12em; font-size:.6rem; color:var(--muted); }
  @media(max-width:600px) { .brand-image img { width:120px; } .brand-image .brand-sub { font-size:.54rem; } }
</style>

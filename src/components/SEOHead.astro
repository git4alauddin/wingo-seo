---
import { site } from '../data/site';
import { siteConfig } from '../../config/site.mjs';
import { canonicalUrl, serializeSchema } from '../../config/seo.mjs';
import { pageSchema, type ArticleMetadata } from '../lib/structured-data';
import { measurementConfig } from '../../config/measurement.mjs';
interface Props { title: string; description: string; path?: string; type?: 'website' | 'article'; noindex?: boolean; article?: ArticleMetadata }
const { title, description, path = Astro.url.pathname, type = 'website', noindex = false, article } = Astro.props;
const pageTitle = title === site.homeTitle ? title : title === site.name ? `${title}: Mechanics, Probability & Randomness` : `${title} | ${site.name}`;
const canonical = noindex ? undefined : canonicalUrl(path, siteConfig.origin);
const image = `${siteConfig.origin}/images/learning-lab-social.png`;
const imageAlt = 'WinGo Learning Lab: the ten digits, their size groups, and overlapping colors. An educational illustration.';
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ff6549" />
{measurementConfig.verificationToken && <meta name="google-site-verification" content={measurementConfig.verificationToken} />}
<title>{pageTitle}</title>
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
{(!siteConfig.indexable || noindex) && <meta name="robots" content="noindex, follow" />}
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
{article && <meta property="article:published_time" content={article.published.toISOString()} />}
{article?.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
{!noindex && <script type="application/ld+json" is:inline set:html={serializeSchema(pageSchema(path, pageTitle, description, article))} />}
<link rel="icon" type="image/png" href="/images/dmplay-logo.png" />

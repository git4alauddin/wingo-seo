---
import couponCodes from '../data/coupons.json';
const referralUrl = 'https://www.dmplay20.com/#/register?invitationCode=96875106250';
const coupons = [...new Set(couponCodes.map(code => code.trim()).filter(Boolean))];
---
<section class="external-game" aria-labelledby="external-game-title">
  <div class="experience-label"><span class="eyebrow">From learning to observation</span><span class="experience-badge">External platform</span></div>
  <h2 id="external-game-title">Observe the concepts<br /><em>in practice.</em></h2>
  <p class="experience-intro">Choose a number. Observe the outcome.<br />Explore the history behind it.</p>
  <ol class="experience-steps" aria-label="An observation exercise">
    <li><span aria-hidden="true">01</span><strong>Choose</strong></li>
    <li><span aria-hidden="true">02</span><strong>Observe</strong></li>
    <li><span aria-hidden="true">03</span><strong>Compare</strong></li>
  </ol>
  <a class="button experience-cta" href={referralUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" referrerpolicy="no-referrer" aria-describedby="external-game-disclosure"><span class="cta-brand" aria-hidden="true"><img src="/images/dmplay-logo.png" width="260" height="113" alt="" /></span><span class="cta-label">Explore external game</span><span class="cta-arrow" aria-hidden="true">↗</span></a>
  {coupons.length > 0 && <div class="coupon-panel" aria-labelledby="coupon-title">
    <div class="coupon-heading"><span class="coupon-gift" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8H8.5A2.5 2.5 0 1 1 11 5.5L12 8Zm0 0h3.5A2.5 2.5 0 1 0 13 5.5L12 8Z"/></svg></span><div><h3 id="coupon-title">Coupon codes</h3></div></div>
    <ul class="coupon-grid" aria-label="Coupon codes">
      {coupons.map(code => <li class="coupon-ticket"><code>{code}</code><button class="coupon-copy" type="button" data-copy-code={code} aria-label={`Copy code ${code}`} title="Copy code" hidden>
        <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
        <svg class="copied-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
      </button></li>)}
    </ul>
    <p class="coupon-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.coupon-panel').forEach(panel => {
    const status = panel.querySelector<HTMLElement>('.coupon-status');
    panel.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach(button => {
      button.hidden = false;
      let reset: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        const code = button.dataset.copyCode!;
        button.disabled = true;
        clearTimeout(reset);
        button.removeAttribute('data-copied');
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = 'true';
          button.title = 'Copied';
          button.setAttribute('aria-label', `Copied code ${code}`);
          if (status) status.textContent = `Copied ${code}`;
        } catch {
          button.title = 'Could not copy';
          button.setAttribute('aria-label', `Could not copy code ${code}. Select the code to copy manually.`);
          if (status) status.textContent = 'Could not copy. Select the code and copy it manually.';
        } finally {
          button.disabled = false;
          reset = setTimeout(() => {
            button.removeAttribute('data-copied');
            button.title = 'Copy code';
            button.setAttribute('aria-label', `Copy code ${code}`);
          }, 2000);
        }
      });
    });
  });
</script>

<style>
  .external-game { position:relative; min-width:0; padding:30px; border:1px solid #795042; border-radius:18px; background:radial-gradient(ellipse at 100% 0,#ff65491c,transparent 65%),linear-gradient(145deg,var(--dark-raised),var(--dark)); color:var(--on-dark); box-shadow:0 18px 45px #5c2d2026,inset 0 1px #ffcfaa14; }
  .experience-label { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-bottom:22px; }
  .external-game .eyebrow { color:#ffcfaa; font-size:.61rem; }
  .experience-badge { padding:3px 7px; border:1px solid #a17c6d; border-radius:4px; font-size:.6rem; color:var(--on-dark-muted); }
  .external-game h2 { font-size:clamp(1.8rem,2.7vw,2.5rem); line-height:1.1; letter-spacing:-.04em; margin-bottom:15px; }
  .external-game h2 em { color:#ffcfaa; }
  .experience-intro { font-size:.9rem; line-height:1.6; color:var(--on-dark-muted); }
  .experience-steps { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin:22px 0; padding:0; list-style:none; }
  .experience-steps li { min-width:0; padding:12px 8px; border:1px solid #ba8c7066; border-radius:8px; background:#ffcfaa08; text-align:center; }
  .experience-steps li>span { display:block; font-size:.65rem; letter-spacing:.1em; color:#ffcfaa; margin-bottom:5px; }
  .experience-steps strong { font-size:.78rem; font-weight:550; }
  .external-game .experience-cta { position:relative; isolation:isolate; overflow:hidden; display:flex; width:100%; min-height:66px; padding:10px 14px; gap:12px; background:linear-gradient(110deg,#ff8969,#ffbf96); border:1px solid #ffe2c4; color:#3a201b; font-size:.95rem; box-shadow:0 6px 24px #ff995b26; animation:experience-attention 1.92s ease-out .6s infinite; }
  .cta-brand { flex:0 0 76px; display:grid; place-items:center; padding:3px 6px; background:#fffdf8; border:1px solid #ffdec8; border-radius:7px; box-shadow:0 2px 5px #7b331518; }
  .cta-brand img { display:block; width:64px; height:auto; }
  .cta-label { flex:1; min-width:0; text-align:center; }
  .cta-arrow { flex:none; font-size:1.35rem; animation:experience-arrow 1.92s ease-in-out .6s infinite; }
  .experience-cta::before { content:''; position:absolute; inset:0 auto 0 0; width:45%; background:linear-gradient(100deg,transparent,#fffc,transparent); pointer-events:none; opacity:0; transform:translateX(-160%) skewX(-20deg); animation:experience-shine 1.92s ease-out .6s infinite; z-index:-1; }
  .external-game .experience-cta:hover,.external-game .experience-cta:focus-visible { background:linear-gradient(110deg,#ffb58d,#ffe2c4); animation:none; box-shadow:0 0 0 4px #ffcfaa40,0 10px 28px #ff995b35; }
  .experience-cta:hover::before,.experience-cta:focus-visible::before { animation:none; opacity:0; }
  .experience-cta:hover .cta-arrow,.experience-cta:focus-visible .cta-arrow { animation:none; }
  .external-game .experience-cta:focus-visible { outline-color:#fffdf8; }
  @keyframes experience-attention {
    0%,48%,100% { transform:translateY(0) scale(1); box-shadow:0 0 0 0 #ffb58d00,0 6px 24px #ff995b26; }
    12%,32% { transform:translateY(-1px) scale(1.012); box-shadow:0 0 0 5px #ffb58d45,0 8px 30px #ffb58d45; }
    22%,44% { transform:translateY(0) scale(1); box-shadow:0 0 0 11px #ffb58d00,0 6px 24px #ff995b26; }
  }
  @keyframes experience-arrow { 0%,8%,28%,48%,100% { transform:translate(0,0); } 18%,38% { transform:translate(3px,-3px); } }
  @keyframes experience-shine {
    0%,4% { opacity:0; transform:translateX(-160%) skewX(-20deg); }
    8% { opacity:.65; }
    28% { opacity:0; transform:translateX(360%) skewX(-20deg); }
    100% { opacity:0; transform:translateX(360%) skewX(-20deg); }
  }
  @media(prefers-reduced-motion:reduce) {
    .external-game .experience-cta,.experience-cta::before,.cta-arrow { animation:none; }
    .experience-cta::before { display:none; }
  }
  .coupon-panel { margin-top:22px; padding:16px; border:1px solid #f5b38a99; border-radius:12px; background:radial-gradient(ellipse at 0 0,#ffad7630,transparent 75%),#ffcfaa05; box-shadow:0 0 22px #ff995b0d,inset 0 1px #ffe2c420; }
  .coupon-heading { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .coupon-gift { flex:none; display:grid; place-items:center; width:36px; height:36px; color:#3a201b; background:linear-gradient(135deg,#ff9976,#ffcfaa); border:1px solid #ffe2c4; border-radius:9px; box-shadow:0 3px 12px #ff995b20; }
  .coupon-heading h3 { margin:0; font-size:.85rem; font-weight:550; letter-spacing:.01em; }
  .coupon-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; list-style:none; margin:0; padding:0; }
  .coupon-ticket { display:flex; align-items:center; gap:9px; min-width:0; padding:11px 10px; border:1px dashed #b2866e; border-radius:7px; background:linear-gradient(110deg,#ffcfaa10,#ffcfaa04); }
  .coupon-ticket:last-child:nth-child(odd) { grid-column:1 / -1; }
  .coupon-ticket code { flex:1; min-width:0; color:#ffcfaa; font-family:var(--font-mono,monospace); font-size:.78rem; letter-spacing:.06em; overflow-wrap:anywhere; user-select:all; }
  .coupon-copy { flex:none; display:grid; place-items:center; width:28px; height:28px; padding:0; border:1px solid #a17c6d; border-radius:5px; background:#ffcfaa0c; color:#ffcfaa; cursor:pointer; }
  .coupon-copy[hidden] { display:none; }
  .coupon-copy:hover,.coupon-copy[data-copied] { background:#ffcfaa; color:#3a201b; }
  .coupon-copy:focus-visible { outline:2px solid #fffdf8; outline-offset:3px; }
  .coupon-copy:disabled { cursor:wait; }
  .copied-icon,.coupon-copy[data-copied] .copy-icon { display:none; }
  .coupon-copy[data-copied] .copied-icon { display:block; }
  .coupon-status { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  @media(max-width:900px) { .external-game { order:-1; width:100%; max-width:560px; justify-self:center; } }
  @media(max-width:600px) {
    .external-game { padding:22px; border-radius:13px; }
    .experience-label { margin-bottom:16px; }
    .external-game h2 { font-size:1.9rem; }
    .experience-steps { margin:16px 0; }
    .external-game .experience-cta { padding-inline:10px; gap:8px; font-size:.88rem; }
    .cta-brand { flex-basis:64px; padding:3px; }
    .cta-brand img { width:56px; }
    .coupon-ticket { padding:10px 7px; gap:6px; }
    .coupon-ticket code { font-size:.7rem; letter-spacing:.02em; }
  }
  @media(max-width:360px) {
    .external-game { padding:18px; }
    .external-game h2 { font-size:1.7rem; }
  }
  @media(max-width:400px) {
    .coupon-panel { padding:12px; }
    .coupon-grid { grid-template-columns:minmax(0,1fr); }
    .coupon-ticket code { font-size:.78rem; }
  }
</style>

---
import giftCard from '../data/gift-card.json';
const coupons = [...new Set(giftCard.gifts.codes.map(code => code.trim()).filter(Boolean))];
const scheduledTime: unknown = giftCard.timer.nextRefreshAt;
const refreshAt = typeof scheduledTime === 'string' && /T.*(?:Z|[+-]\d{2}:\d{2})$/.test(scheduledTime) && Number.isFinite(Date.parse(scheduledTime)) ? scheduledTime : '';
const refreshLabel = refreshAt ? new Intl.DateTimeFormat('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }).format(new Date(refreshAt)) + ' IST' : '';
---
<section class="external-game" aria-labelledby="external-game-title">
  <div class="experience-label"><span class="eyebrow">{giftCard.eyebrow}</span><span class="experience-badge">{giftCard.badge}</span></div>
  <div class="gift-countdown" data-refresh-at={refreshAt} data-active-text={giftCard.timer.activeText} data-ended-text={giftCard.timer.endedText} data-state="pending">
    <h2 id="external-game-title" class="claim-heading"><span class="claim-static">{giftCard.heading}</span><span class="claim-visual" aria-hidden="true" hidden><span class="claim-size">{giftCard.heading}</span><span class="claim-typed"></span></span></h2>
    <p class="drop-caption" data-drop-caption>{refreshAt ? giftCard.timer.activeText : giftCard.timer.pendingText}</p>
    <div class="drop-clock" role="timer" aria-label="Time until the next gift-code drop" aria-live="off" hidden>
      {['Hours', 'Minutes', 'Seconds'].map(unit => <div class="drop-unit"><span class="drop-face"><span class="drop-value" data-drop-unit={unit.toLowerCase()}>--</span></span><span class="drop-label">{unit}</span></div>)}
    </div>
  </div>
  <a class="button experience-cta" href={giftCard.link.url} target="_blank" rel="sponsored nofollow noopener noreferrer" referrerpolicy="no-referrer" aria-describedby="external-game-disclosure" title={`${giftCard.link.label} (opens in a new tab)`}><span class="cta-brand" aria-hidden="true"><img src={giftCard.link.logo} width="260" height="113" alt="" /></span><span class="cta-label">{giftCard.link.label}</span><span class="cta-arrow" aria-hidden="true">↗</span></a>
  {coupons.length > 0 && <div class="coupon-panel" aria-labelledby="coupon-title">
    <div class="coupon-heading"><span class="coupon-gift" aria-hidden="true"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13M12 8H8.5A2.5 2.5 0 1 1 11 5.5L12 8Zm0 0h3.5A2.5 2.5 0 1 0 13 5.5L12 8Z"/></svg></span><div><h3 id="coupon-title">{giftCard.gifts.title}</h3></div><details class="gift-info">
      <summary aria-label="Gift-code information"><span aria-hidden="true">i</span></summary>
      <div class="gift-info-content"><p>{giftCard.gifts.infoText}</p><p class="drop-date">{refreshAt ? <>{giftCard.timer.scheduledLabel} <time datetime={refreshAt}>{refreshLabel}</time></> : giftCard.timer.unscheduledText}</p></div>
    </details></div>
    <ul class="coupon-grid" aria-label={giftCard.gifts.title}>
      {coupons.map(code => <li class="coupon-ticket"><code>{code}</code><button class="coupon-copy" type="button" data-copy-code={code} aria-label={`Copy code ${code}`} title="Copy code" hidden>
        <svg class="copy-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg>
        <svg class="copied-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg>
        <span class="coupon-confetti" aria-hidden="true">{Array.from({ length: 12 }, (_, index) => <i style={{ backgroundColor: ['#ff9e7c', '#ffd77a', '#fff1d8', '#c3a1ff'][index % 4] }} />)}</span>
      </button></li>)}
    </ul>
    <p class="coupon-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </div>}
</section>

<script>
  document.querySelectorAll<HTMLElement>('.claim-heading').forEach(heading => {
    const fullText = heading.querySelector<HTMLElement>('.claim-static')!;
    const visual = heading.querySelector<HTMLElement>('.claim-visual')!;
    const typed = heading.querySelector<HTMLElement>('.claim-typed')!;
    const characters = Array.from(fullText.textContent ?? '');
    if (!characters.length) return;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let timer: ReturnType<typeof setTimeout> | undefined;
    let count = 0;
    let deleting = false;
    const step = () => {
      if (motion.matches || document.hidden) return;
      count += deleting ? -1 : 1;
      typed.textContent = characters.slice(0, count).join('');
      let delay = deleting ? 30 : 65;
      if (count === characters.length) { deleting = true; delay = 1800; }
      if (count === 0) { deleting = false; delay = 450; }
      timer = setTimeout(step, delay);
    };
    const sync = () => {
      clearTimeout(timer);
      fullText.classList.toggle('sr-only', !motion.matches);
      visual.hidden = motion.matches;
      if (motion.matches) return;
      count = 0;
      deleting = false;
      typed.textContent = '';
      step();
    };
    motion.addEventListener('change', sync);
    document.addEventListener('visibilitychange', () => {
      clearTimeout(timer);
      if (!document.hidden && !motion.matches) timer = setTimeout(step, 450);
    });
    sync();
  });

  document.querySelectorAll<HTMLElement>('[data-refresh-at]').forEach(countdown => {
    const target = Date.parse(countdown.dataset.refreshAt ?? '');
    if (!Number.isFinite(target)) return;
    const clock = countdown.querySelector<HTMLElement>('.drop-clock')!;
    const caption = countdown.querySelector<HTMLElement>('[data-drop-caption]')!;
    let interval: ReturnType<typeof setInterval> | undefined;
    const update = () => {
      const seconds = Math.max(0, Math.ceil((target - Date.now()) / 1000));
      countdown.dataset.state = seconds > 0 ? 'active' : 'ended';
      clock.hidden = false;
      const values = { hours: Math.floor(seconds / 3600), minutes: Math.floor(seconds / 60) % 60, seconds: seconds % 60 };
      for (const [unit, value] of Object.entries(values)) {
        const digit = countdown.querySelector<HTMLElement>(`[data-drop-unit="${unit}"]`)!;
        const text = String(value).padStart(2, '0');
        if (digit.textContent === text) continue;
        const wasRunning = digit.textContent !== '--';
        digit.textContent = text;
        digit.dataset.wide = String(text.length > 3);
        if (wasRunning && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          digit.getAnimations().forEach(animation => animation.cancel());
          digit.animate([
            { transform: 'rotateX(-80deg)', opacity: .35, filter: 'brightness(1.6)' },
            { transform: 'rotateX(7deg)', opacity: 1, filter: 'brightness(1.1)', offset: .72 },
            { transform: 'rotateX(0)', opacity: 1, filter: 'brightness(1)' },
          ], { duration: 420, easing: 'cubic-bezier(.2,.7,.25,1)' });
        }
      }
      caption.textContent = seconds > 0 ? countdown.dataset.activeText ?? '' : countdown.dataset.endedText ?? '';
      if (!seconds) clearInterval(interval);
    };
    update();
    if (target > Date.now()) interval = setInterval(update, 1000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) update(); });
  });

  function celebrateCopy(button: HTMLButtonElement) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    button.querySelectorAll<HTMLElement>('.coupon-confetti i').forEach((piece, index) => {
      piece.getAnimations().forEach(animation => animation.cancel());
      if (reducedMotion || typeof piece.animate !== 'function') return;
      const angle = (-160 + index * (140 / 11)) * Math.PI / 180;
      const distance = 26 + (index % 3) * 7;
      const x = Math.cos(angle) * distance;
      const y = Math.sin(angle) * distance;
      piece.animate([
        { transform: 'translate(-50%, -50%) scale(.3)', opacity: 0, offset: 0 },
        { opacity: 1, offset: .12 },
        { transform: `translate(${x}px, ${y}px) rotate(${index * 55 + 90}deg)`, opacity: .9, offset: .6 },
        { transform: `translate(${x * 1.1}px, ${y + 30}px) rotate(${index * 55 + 270}deg) scale(.6)`, opacity: 0, offset: 1 },
      ], { duration: 680 + (index % 3) * 40, easing: 'ease-out' });
    });
  }

  document.querySelectorAll<HTMLElement>('.coupon-panel').forEach(panel => {
    const status = panel.querySelector<HTMLElement>('.coupon-status');
    panel.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach(button => {
      button.hidden = false;
      let reset: ReturnType<typeof setTimeout> | undefined;
      button.addEventListener('click', async () => {
        const code = button.dataset.copyCode!;
        button.disabled = true;
        clearTimeout(reset);
        button.removeAttribute('data-copied');
        try {
          await navigator.clipboard.writeText(code);
          button.dataset.copied = 'true';
          button.title = 'Copied';
          button.setAttribute('aria-label', `Copied code ${code}`);
          if (status) status.textContent = `Copied ${code}`;
          celebrateCopy(button);
        } catch {
          button.title = 'Could not copy';
          button.setAttribute('aria-label', `Could not copy code ${code}. Select the code to copy manually.`);
          if (status) status.textContent = 'Could not copy. Select the code and copy it manually.';
        } finally {
          button.disabled = false;
          reset = setTimeout(() => {
            button.removeAttribute('data-copied');
            button.title = 'Copy code';
            button.setAttribute('aria-label', `Copy code ${code}`);
          }, 2000);
        }
      });
    });
  });
</script>

<style>
  .external-game { position:relative; min-width:0; padding:30px; border:1px solid #795042; border-radius:18px; background:radial-gradient(ellipse at 100% 0,#ff65491c,transparent 65%),linear-gradient(145deg,var(--dark-raised),var(--dark)); color:var(--on-dark); box-shadow:0 18px 45px #5c2d2026,inset 0 1px #ffcfaa14; }
  .experience-label { display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; margin-bottom:22px; }
  .external-game .eyebrow { color:#ffcfaa; font-size:.61rem; }
  .experience-badge { padding:3px 7px; border:1px solid #a17c6d; border-radius:4px; font-size:.6rem; color:var(--on-dark-muted); }
  .external-game h2 { font-size:clamp(1.5rem,2.4vw,2rem); line-height:1.1; letter-spacing:-.04em; margin-bottom:10px; }
  .claim-visual { position:relative; display:block; }
  .claim-visual[hidden] { display:none; }
  .claim-size { display:block; visibility:hidden; }
  .claim-typed { position:absolute; inset:0; }
  .claim-typed::after { content:''; display:inline-block; width:0; height:.85em; margin-left:2px; border-right:2px solid #ffcfaa; vertical-align:-.05em; animation:claim-cursor 1.1s step-end infinite; }
  @keyframes claim-cursor { 0%,100% { opacity:1; } 50% { opacity:0; } }
  .drop-caption { color:#ffcfaa; font-size:.84rem; }
  .drop-clock { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16px; margin-top:18px; }
  .drop-clock[hidden] { display:none; }
  .drop-unit { position:relative; min-width:0; text-align:center; }
  .drop-unit + .drop-unit::before { content:':'; position:absolute; left:-12px; top:12px; color:#ffbc92; font-size:1.5rem; line-height:1.2; opacity:.8; }
  .drop-face { position:relative; display:block; perspective:450px; padding:12px 5px; border:1px solid #b98167; border-radius:10px; background:linear-gradient(180deg,#553831 0%,#422c29 49.5%,#362624 50%,#46302b 100%); box-shadow:inset 0 1px #ffdfbf30,0 5px 12px #160f1326; }
  .drop-face::after { content:''; position:absolute; top:50%; left:0; right:0; height:1px; background:#170e1370; box-shadow:0 1px #ffcfaa15; pointer-events:none; }
  .drop-value { display:block; color:#ffe0bd; font-size:clamp(1.6rem,4.2vw,2.8rem); font-weight:650; font-variant-numeric:tabular-nums; line-height:1.15; transform-origin:center; text-shadow:0 2px 10px #ffad7620; }
  .drop-value[data-wide="true"] { font-size:1.25rem; }
  .drop-label { display:block; color:var(--on-dark-muted); font-size:.55rem; letter-spacing:.1em; text-transform:uppercase; margin-top:9px; }
  .drop-date { color:var(--on-dark-muted); font-size:.65rem; margin-top:10px; }
  .gift-countdown[data-state="active"] .drop-unit:last-child .drop-face { border-color:#ffc196; animation:drop-halo 3s ease-in-out infinite; }
  @keyframes drop-halo { 0%,100% { box-shadow:inset 0 1px #ffdfbf30,0 0 0 0 #ffb58d00,0 5px 12px #160f1326; } 50% { box-shadow:inset 0 1px #ffe0bd60,0 0 0 3px #ffb58d18,0 0 20px #ff995b33; } }
  .external-game .experience-cta { position:relative; overflow:hidden; display:flex; width:100%; min-height:62px; margin-top:22px; padding:10px 14px; gap:12px; background:linear-gradient(110deg,#ff9e7c,#ffd3ac); border:1px solid #ffe0bd; color:#3a201b; font-size:.95rem; box-shadow:0 4px 16px #ff995b20; animation:experience-ripple 1.5s ease-out .3s infinite; }
  .experience-cta::after { content:''; position:absolute; inset:-30% auto -30% 0; width:40%; background:linear-gradient(90deg,transparent,#fff7,transparent); opacity:0; pointer-events:none; transform:translateX(-160%) skewX(-20deg); animation:experience-sweep 1.5s ease-in-out .3s infinite; }
  .cta-brand { flex:0 0 76px; display:grid; place-items:center; padding:3px 6px; background:#fffdf8; border:1px solid #ffdec8; border-radius:7px; box-shadow:0 2px 5px #7b331518; }
  .cta-brand img { display:block; width:64px; height:auto; }
  .cta-label { flex:1; min-width:0; text-align:center; }
  .cta-arrow { flex:none; font-size:1.15rem; color:#6d4032; animation:experience-arrow 1.5s ease-in-out .3s infinite; }
  .external-game .experience-cta:hover,.external-game .experience-cta:focus-visible { background:linear-gradient(110deg,#ffb291,#ffe1c4); transform:none; box-shadow:0 0 0 3px #ffcfaa26; animation:none; }
  .experience-cta:hover::after,.experience-cta:focus-visible::after { animation:none; opacity:0; }
  .experience-cta:hover .cta-arrow,.experience-cta:focus-visible .cta-arrow { animation:none; transform:none; }
  .external-game .experience-cta:focus-visible { outline-color:#fffdf8; }
  @keyframes experience-sweep {
    0%,6% { opacity:0; transform:translateX(-160%) skewX(-20deg); }
    10% { opacity:.6; }
    28% { opacity:0; transform:translateX(380%) skewX(-20deg); }
    100% { opacity:0; transform:translateX(380%) skewX(-20deg); }
  }
  @keyframes experience-ripple {
    0%,100% { box-shadow:0 0 0 0 #ffb58d00,0 0 0 0 #ffb58d00,0 4px 16px #ff995b20; }
    12% { box-shadow:0 0 0 1px #ffb58d66,0 0 0 0 #ffb58d33,0 6px 24px #ff995b40; }
    48% { box-shadow:0 0 0 8px #ffb58d14,0 0 0 4px #ffb58d40,0 6px 22px #ff995b30; }
    82% { box-shadow:0 0 0 16px #ffb58d00,0 0 0 11px #ffb58d00,0 4px 16px #ff995b20; }
  }
  @keyframes experience-arrow {
    0%,8%,28%,100% { transform:translate(0,0); }
    16% { transform:translate(3px,-3px); }
  }
  @media(prefers-reduced-motion:reduce) {
    .external-game .experience-cta,.experience-cta::after,.cta-arrow { animation:none; }
    .experience-cta::after { display:none; }
    .gift-countdown[data-state="active"] .drop-unit:last-child .drop-face { animation:none; }
  }
  .coupon-panel { margin-top:22px; padding:16px; border:1px solid #f5b38aaa; border-radius:12px; background:radial-gradient(ellipse at 0 0,#ffad7640,transparent 75%),#ffcfaa08; box-shadow:0 0 22px #ff995b14,inset 0 1px #ffe2c426; }
  .coupon-heading { display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .coupon-gift { flex:none; display:grid; place-items:center; width:36px; height:36px; color:#3a201b; background:linear-gradient(135deg,#ff9976,#ffcfaa); border:1px solid #ffe2c4; border-radius:9px; box-shadow:0 3px 12px #ff995b20; }
  .coupon-heading h3 { margin:0; font-size:.85rem; font-weight:550; letter-spacing:.01em; }
  .gift-info { position:relative; flex:none; margin-left:auto; }
  .gift-info summary { display:grid; place-items:center; width:28px; height:28px; list-style:none; border:1px solid #b58e79; border-radius:50%; color:#ffcfaa; font:italic 600 .85rem Georgia,serif; cursor:pointer; }
  .gift-info summary::-webkit-details-marker { display:none; }
  .gift-info summary:hover,.gift-info[open] summary { background:#ffcfaa16; border-color:#ffcfaa; }
  .gift-info summary:focus-visible { outline:2px solid #fffdf8; outline-offset:3px; }
  .gift-info-content { position:absolute; top:calc(100% + 10px); right:0; z-index:5; width:min(260px,calc(100vw - 112px)); padding:14px; border:1px solid #b58e79; border-radius:9px; background:#302126; box-shadow:0 8px 24px #140d1255; color:var(--on-dark); font-size:.73rem; line-height:1.6; }
  .coupon-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; list-style:none; margin:0; padding:0; }
  .coupon-ticket { display:flex; align-items:center; gap:9px; min-width:0; padding:11px 10px; border:1px dashed #b2866e; border-radius:7px; background:linear-gradient(110deg,#ffcfaa10,#ffcfaa04); }
  .coupon-ticket:last-child:nth-child(odd) { grid-column:1 / -1; }
  .coupon-ticket code { flex:1; min-width:0; color:#ffcfaa; font-family:var(--font-mono,monospace); font-size:.78rem; letter-spacing:.06em; overflow-wrap:anywhere; user-select:all; }
  .coupon-copy { position:relative; flex:none; display:grid; place-items:center; width:28px; height:28px; padding:0; border:1px solid #a17c6d; border-radius:5px; background:#ffcfaa0c; color:#ffcfaa; cursor:pointer; }
  .coupon-confetti { position:absolute; top:50%; left:50%; width:0; height:0; z-index:2; pointer-events:none; }
  .coupon-confetti i { position:absolute; top:0; left:0; width:4px; height:7px; border-radius:1px; opacity:0; }
  .coupon-copy[hidden] { display:none; }
  .coupon-copy:hover,.coupon-copy[data-copied] { background:#ffcfaa; color:#3a201b; }
  .coupon-copy:focus-visible { outline:2px solid #fffdf8; outline-offset:3px; }
  .coupon-copy:disabled { cursor:wait; }
  .copied-icon,.coupon-copy[data-copied] .copy-icon { display:none; }
  .coupon-copy[data-copied] .copied-icon { display:block; }
  .coupon-status { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; border:0; }
  @media(max-width:900px) { .external-game { order:-1; width:100%; max-width:560px; justify-self:center; } }
  @media(max-width:600px) {
    .external-game { padding:22px; border-radius:13px; }
    .experience-label { margin-bottom:16px; }
    .external-game h2 { font-size:1.6rem; }
    .external-game .experience-cta { padding-inline:10px; gap:8px; font-size:.88rem; }
    .cta-brand { flex-basis:64px; padding:3px; }
    .cta-brand img { width:56px; }
    .coupon-ticket { padding:10px 7px; gap:6px; }
    .coupon-ticket code { font-size:.7rem; letter-spacing:.02em; }
  }
  @media(max-width:360px) {
    .external-game { padding:18px; }
    .external-game h2 { font-size:1.45rem; }
  }
  @media(max-width:400px) {
    .coupon-panel { padding:12px; }
    .coupon-grid { grid-template-columns:minmax(0,1fr); }
    .coupon-ticket code { font-size:.78rem; }
  }
</style>

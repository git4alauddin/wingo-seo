---
import { classifications } from '../data/site';
import GameBall from './GameBall.astro';
---
<div class="table-wrap game-table"><table><caption>Example ruleset used throughout this lab</caption><thead><tr><th scope="col">Number</th><th scope="col">Size</th><th scope="col">Color membership</th></tr></thead><tbody>{classifications.map(row => <tr><th scope="row"><GameBall digit={row.digit} class="digit-small" /><span class="sr-only">{row.digit}</span></th><td><span class:list={['size-tag', row.size.toLowerCase()]}>{row.size}</span></td><td>{row.colors.map(color => <span class:list={['color-tag', color.toLowerCase()]}>{color}</span>)}</td></tr>)}</tbody></table></div>

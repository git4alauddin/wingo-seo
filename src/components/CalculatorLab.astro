---
import { eventOptions } from '../lib/probability';
import '../styles/tools.css';
---
<section class="tool-panel calculator-panel interactive-lab" data-calculator aria-labelledby="calculator-title">
  <div class="figure-topline"><span class="eyebrow">Uniform digits · independent draws</span><span class="pill">Probability calculator</span></div>
  <h2 id="calculator-title">Ask a precise question.</h2>
  <p class="model-notice">Calculations describe this educational model, not an external game. Browser-generated trial results are local synthetic data, not live results or predictions.</p>
  <p class="no-js-note" data-fallback>Enable JavaScript to calculate. A fixed example: P(7) = 1/10 = 10%. The worked explanations below remain available without JavaScript.</p>
  <div data-enhanced hidden>
    <form data-event-form novalidate><div class="field"><label for="calc-event">Event in one draw</label><select id="calc-event" aria-describedby="calc-event-help calc-event-error">{eventOptions.map(option => <option value={option.value} selected={option.value === '7'}>{option.label}</option>)}</select><span id="calc-event-help" class="field-help">Size/color conditions refer to the same digit. Compound choices count qualifying digits once.</span></div><button class="button" type="submit">Calculate event</button></form>
    <p id="calc-event-error" class="tool-error" role="alert" data-event-error></p><div class="calculation-result" role="status" data-event-result>Choose an event and calculate.</div>
    <section class="calculator-section" aria-labelledby="sequence-title"><h3 id="sequence-title">An exact ordered sequence</h3><p class="field-help">Specify the next block of draws, in order. This is not the probability of a streak anywhere in a longer session.</p><form data-sequence-form novalidate><div class="field"><label for="calc-sequence">Ordered events (comma-separated)</label><textarea id="calc-sequence" rows="2" maxlength="400" aria-describedby="calc-sequence-help calc-sequence-error">Big, Big, Small</textarea><span id="calc-sequence-help" class="field-help">Use 1–20 events: digits 0–9, Big, Small, Red, Green, or Violet.</span></div><div class="preset-row"><span>Examples:</span><button type="button" data-sequence-example="7, 7">7, 7</button><button type="button" data-sequence-example="Big, Big, Small">Big, Big, Small</button></div><button class="button" type="submit">Calculate sequence</button></form><p id="calc-sequence-error" class="tool-error" role="alert" data-sequence-error></p><div class="calculation-result" role="status" data-sequence-result>Enter a sequence to calculate.</div></section>
    <section class="calculator-section" aria-labelledby="trials-title"><h3 id="trials-title">Compare with a random sample</h3><p class="field-help">Uses the event currently selected above. The result names that event so changing the selection later does not relabel old data.</p><form data-trials-form novalidate><div class="field"><label for="calc-trials">Trial count (1–10,000)</label><input id="calc-trials" type="number" min="1" max="10000" step="1" value="200" aria-describedby="calc-trials-error" /></div><div class="tool-actions"><button class="button" type="submit" data-trials-start>Run comparison</button><button class="button button-quiet" type="button" data-trials-cancel disabled>Cancel comparison</button></div></form><p id="calc-trials-error" class="tool-error" role="alert" data-trials-error></p><p class="field-help" data-trials-progress></p><div class="calculation-result" role="status" data-trials-result>No trial sample yet.</div></section>
  </div>
</section>
<script>import '../scripts/calculator';</script>

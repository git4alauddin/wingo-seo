---
import { classifications } from '../data/site';
import GameBall from './GameBall.astro';
---
<div class="number-grid" role="list" aria-label="The ten digits and their classifications">
  {classifications.map(row => <div class="number-cell" role="listitem"><GameBall digit={row.digit} /><span class="number-label"><strong>{row.digit} · {row.size}</strong><span>{row.colors.join(' + ')}</span></span></div>)}
</div>

---
interface Props { name?: 'arrow' | 'book' | 'grid' | 'chart' | 'spark' | 'check'; size?: number }
const { name = 'arrow', size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {name === 'book' && <><path d="M12 5v15M3 4c4-1 7 0 9 2 2-2 5-3 9-2v14c-4-1-7 0-9 2-2-2-5-3-9-2Z" /></>}
  {name === 'grid' && <><rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><rect x="14" y="14" width="6" height="6" rx="1"/></>}
  {name === 'chart' && <path d="M4 4v16h17M8 15v-4m5 4V6m5 9v-6"/>}
  {name === 'spark' && <path d="m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5Z"/>}
  {name === 'check' && <path d="m5 12 4 4L19 6"/>}
</svg>

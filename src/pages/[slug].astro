---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import { publishedGuides } from '../lib/guides';
import ArticleLayout from '../layouts/ArticleLayout.astro';
export const getStaticPaths = (async () => {
  const guides = await publishedGuides();
  return guides.filter(guide => guide.data.slug !== 'patterns-and-randomness').map(guide => ({ params: { slug: guide.data.slug }, props: { guide } }));
}) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
---
<ArticleLayout guide={guide} headings={headings}><Content /></ArticleLayout>

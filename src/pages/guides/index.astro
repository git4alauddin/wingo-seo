---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { publishedGuides } from '../../lib/guides';
const guides = await publishedGuides();
---
<BaseLayout title="Probability and WinGo Mechanics Guides" description="Follow a clear learning path through WinGo-style classifications, number probability, independent events, streaks, and simulated history.">
  <div class="container"><Breadcrumbs items={[{ label: 'Guides' }]} /></div>
  <header class="page-header container"><p class="eyebrow">The reading room</p><h1>A clearer picture,<br /><em>one idea at a time.</em></h1><p>Seven guides to help you read the classifications, work through the probability, and ask better questions about the patterns, including an independent DmPlay WinGo screen guide.</p></header>
  <section class="container learning-paths" aria-labelledby="path-title"><h2 id="path-title" class="sr-only">Choose a learning path</h2><div class="path-card"><span class="eyebrow">Path 01 / Start here</span><h2>New to the mechanics?</h2><p>Overview → rules → Big and Small → number probability.</p><a class="text-link" href="/what-is-wingo/">Begin with the basics <Icon /></a></div><div class="path-card"><span class="eyebrow">Path 02 / Think critically</span><h2>Curious about a pattern?</h2><p>Randomness → historical analysis → a local experiment.</p><a class="text-link" href="/patterns-and-randomness/">Start with randomness <Icon /></a></div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">Your field notes</p><h2>All learning guides</h2></div><span class="small-label">{String(guides.length).padStart(2, '0')} GUIDES · BEGINNER FRIENDLY</span></div><div class="article-grid guides-grid">{guides.map(guide => <ArticleCard guide={guide} />)}</div></section>
</BaseLayout>

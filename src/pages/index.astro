---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import NumberGrid from '../components/NumberGrid.astro';
import SampleComparison from '../components/SampleComparison.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ExternalGameCard from '../components/ExternalGameCard.astro';
import GameBall from '../components/GameBall.astro';
import GameTrend from '../components/GameTrend.astro';
import { publishedGuides } from '../lib/guides';
import { site } from '../data/site';
const guides = await publishedGuides();
const topics = [
  { index: '01', title: 'Know the mechanics', text: 'One digit, a size, and sometimes two colors. Start with the full picture.', href: '/wingo-rules/', icon: 'grid' as const },
  { index: '02', title: 'Think in probabilities', text: 'Count the possibilities. See exactly where a mathematical probability comes from.', href: '/number-probability/', icon: 'chart' as const },
  { index: '03', title: 'Question the patterns', text: 'A streak can catch your eye. Learn what it can—and cannot—tell you.', href: '/patterns-and-randomness/', icon: 'spark' as const },
];
---
<BaseLayout title={site.name} description={site.description}>
  <section class="hero container">
    <div class="hero-copy"><p class="eyebrow"><span class="tiny-square"></span> Learn. Observe. Compare.</p><h1>Learn WinGo.<br /><em>Observe it<br />in practice.</em></h1><p class="hero-description">Understand the numbers, colors, and Big/Small classifications. Then explore how those concepts appear in an external game—or start with a local learning experiment.</p><div class="hero-actions"><a class="button button-quiet" href="/simulator/">Explore the Simulator <Icon /></a><a class="text-link" href="/number-probability/">Learn Probability <Icon name="book" /></a></div><p class="hero-footnote"><Icon name="check" size={16} /> Educational models. No prediction promises.</p></div>
    <ExternalGameCard />
  </section>
  <div class="principle-strip"><div class="container"><span>Ten possible digits.</span><span>Clearly stated assumptions.</span><span>Better questions about chance.</span><a href="/about/">Meet the lab <span aria-hidden="true">↗</span></a></div></div>
  <section class="section container" aria-labelledby="begin-title"><div class="section-heading"><div><p class="eyebrow">01 / Get your bearings</p><h2 id="begin-title">A familiar format.<br />A different way to learn.</h2></div><p class="section-intro">Start with what a result means. Then explore the mathematics behind it.</p></div><div class="topic-grid">{topics.map(topic => <a class="topic-card" href={topic.href}><div class="topic-top"><span>{topic.index}</span><span class="icon-box"><Icon name={topic.icon} size={25} /></span></div><h3>{topic.title}</h3><p>{topic.text}</p><span class="topic-link">Explore the topic <Icon /></span></a>)}</div></section>
  <section class="classification-section"><div class="container classification-layout"><div><p class="eyebrow">02 / Decode a result</p><h2>One digit. <br />A few useful labels.</h2><p>In our example ruleset, 0–4 are Small and 5–9 are Big. Colors add another classification: 0 and 5 each belong to two color groups.</p><a class="text-link" href="/wingo-rules/">See the complete rules <Icon /></a></div><div class="classification-sheet"><div class="sheet-heading"><span class="eyebrow">The 0–9 field guide</span><span class="pill">Example ruleset</span></div><NumberGrid /><p class="sheet-footnote">Labels describe this lab’s model. External versions may use different rules.</p></div></div></section>
  <section class="section container simulator-feature" aria-labelledby="experiment-title"><div class="experiment-preview"><div class="figure-topline"><span class="eyebrow">Inside the learning lab</span><span class="pill">Static preview</span></div><div class="experiment-result"><GameBall digit={8} /><div><span class="small-label">ILLUSTRATIVE OUTCOME</span><strong>8 <span>→</span> Big + Red</strong><p>One number determines both labels.</p></div></div><div class="model-stats"><div><strong>10</strong><span>possible digits</span></div><div><strong>10%</strong><span>per digit in our model</span></div><div><strong>50%</strong><span>Big or Small</span></div></div><p class="preview-note">Illustration only. Open the simulator to generate your own local sample.</p><GameTrend digits={[7, 2, 0, 5, 8]} caption="Illustrative draw sequence · latest first · not live results" /></div><div class="feature-copy"><p class="eyebrow">03 / Make it concrete</p><h2>See the model.<br /><em>Understand the assumption.</em></h2><p>Run timed rounds or batch experiments in your browser. Compare counts with the model, inspect a recorded run, and keep the assumptions in view—without connecting to a real game.</p><a class="button" href="/simulator/">Explore the Simulator <Icon /></a><p class="fine-print">Local education. No accounts, balances, or transactions.</p></div></section>
  <section class="randomness-section"><div class="container randomness-layout"><div><p class="eyebrow">04 / Look beyond the streak</p><h2>Uneven doesn’t<br />mean predictable.</h2><p>A short sample can look lopsided. In an independent model, that doesn’t make the next result “due.” Learn to separate an interesting observation from a prediction.</p><a class="text-link" href="/patterns-and-randomness/">Explore patterns & randomness <Icon /></a></div><SampleComparison /></div></section>
  <section class="section container" aria-labelledby="guides-title"><div class="section-heading"><div><p class="eyebrow">From curiosity to clarity</p><h2 id="guides-title">A good place to start reading.</h2></div><a class="text-link" href="/guides/">Browse all guides <Icon /></a></div><div class="article-grid">{[guides[0], guides[3], guides[5]].map(guide => <ArticleCard guide={guide} />)}</div></section>
  <section class="container limits-section"><div class="limit-icon"><Icon name="book" size={30} /></div><div><p class="eyebrow">What this lab can tell you</p><h2>Understanding has value.<br />Certainty has limits.</h2><p>We explain a specified mathematical model using original guides and synthetic examples. We do not verify external game fairness, forecast future outcomes, or offer a winning strategy.</p><a class="text-link" href="/about/">Read our purpose & limitations <Icon /></a></div><span class="limit-notation" aria-hidden="true">P(?)</span></section>
</BaseLayout>

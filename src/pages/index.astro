---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import NumberGrid from '../components/NumberGrid.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ExternalGameCard from '../components/ExternalGameCard.astro';
import GameBall from '../components/GameBall.astro';
import GameTrend from '../components/GameTrend.astro';
import { publishedGuides } from '../lib/guides';
import { site } from '../data/site';
const guides = await publishedGuides();
const featuredGuides = ['dmplay-wingo-guide', 'wingo-rules', 'historical-analysis'].map(slug => guides.find(guide => guide.data.slug === slug)!);
---
<BaseLayout title={site.homeTitle} description={site.description}>
  <div class="home-hero">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow"><span class="tiny-square"></span> DmPlay &amp; WinGo learning guides</p>
      <h1>Learn WinGo.<br /><em>Numbers made clear.</em></h1>
      <p class="hero-description">WinGo rules, number colors, Big/Small, and history charts. Learn the basics here, then try the local simulator.</p>
      <div class="hero-actions"><a class="button button-quiet" href="/simulator/">Explore the Simulator <Icon /></a></div>
      <a class="text-link hero-guide-link" href="/dmplay-wingo-guide/">Read the DmPlay WinGo guide <Icon name="book" size={16} /></a>
    </div>
    <ExternalGameCard />
  </section>
  </div>
  <section class="classification-section" aria-labelledby="classification-title">
    <div class="container classification-layout">
      <div><p class="eyebrow">01 / Numbers &amp; colors</p><h2 id="classification-title">WinGo balls,<br />at a glance.</h2><p>0&ndash;4 are Small. 5&ndash;9 are Big. In this ruleset, 0 and 5 each carry two colors.</p><a class="text-link" href="/wingo-rules/">WinGo rules &amp; color guide <Icon /></a></div>
      <div class="classification-sheet"><div class="sheet-heading"><span class="eyebrow">Numbers 0&ndash;9</span><span class="pill">Example ruleset</span></div><NumberGrid /><p class="sheet-footnote">Illustrative classifications. External game rules may differ.</p></div>
    </div>
  </section>
  <section class="section container simulator-feature" aria-labelledby="experiment-title">
    <div class="experiment-preview">
      <div class="figure-topline"><span class="eyebrow">WinGo history chart</span><span class="pill">Illustration</span></div>
      <div class="experiment-result"><GameBall digit={8} /><div><span class="small-label">Sample result</span><strong>8 <span>&rarr;</span> Big + Red</strong></div></div>
      <GameTrend digits={[7, 2, 0, 5, 8]} caption="Illustrative sequence · latest first · not live results" />
    </div>
    <div class="feature-copy"><p class="eyebrow">02 / History &amp; simulation</p><h2 id="experiment-title">Read the chart.<br /><em>Try a local round.</em></h2><p>Follow each result on the chart or generate a sample in your browser. Past results describe history; they do not predict the next number.</p><a class="button" href="/simulator/">Explore the Simulator <Icon /></a><a class="text-link history-guide-link" href="/historical-analysis/">How to read WinGo history <Icon name="book" size={16} /></a></div>
  </section>
  <section class="section container home-guides" aria-labelledby="guides-title">
    <div class="section-heading"><div><p class="eyebrow">03 / Find your answer</p><h2 id="guides-title">A guide for your question.</h2></div><a class="text-link" href="/guides/">All WinGo guides <Icon /></a></div>
    <div class="article-grid">{featuredGuides.map(guide => <ArticleCard guide={guide} />)}</div>
    <div class="home-more-guides"><span>More to explore</span><a href="/number-probability/">Number probability</a><a href="/big-small-explained/">Big &amp; Small explained</a><a href="/patterns-and-randomness/">Patterns &amp; randomness</a></div>
  </section>
  <aside class="container home-notes" aria-label="About this learning site">
    <p>Independent educational site. Local examples are illustrative, with no live results or prediction promises.</p>
    <p id="external-game-disclosure">Referral link &middot; Opens external registration in a new tab. Demo-only access has not been verified.</p>
    <a class="text-link" href="/about/">About this site <Icon size={16} /></a>
  </aside>
</BaseLayout>

<style>
  .home-hero { background:radial-gradient(ellipse at 82% 35%,#ff9c745c,transparent 55%),radial-gradient(ellipse at 10% 10%,#ffd4b84d,transparent 50%),linear-gradient(180deg,#fff2e7,var(--paper)); }
  .classification-section { background:linear-gradient(115deg,#fae9db,#fff2e7); }
  .home-guides { border-top:1px solid var(--line); }
  .home-more-guides { display:flex; flex-wrap:wrap; align-items:center; gap:12px 24px; margin-top:24px; font-size:.78rem; }
  .home-more-guides span { color:var(--muted); }
  .home-more-guides a { color:var(--brand); }
  .history-guide-link { display:flex; width:fit-content; margin-top:18px; font-size:.8rem; }
  .home-notes { padding-block:24px 36px; border-top:1px solid var(--line); color:var(--muted); font-size:.75rem; }
  .home-notes p + p { margin-top:8px; }
  .home-notes .text-link { margin-top:12px; font-size:.75rem; }
  @media(max-width:600px) {
    .home-hero { background:radial-gradient(ellipse at 50% 15%,#ffb08d4d,transparent 55%),linear-gradient(180deg,#fff2e7,var(--paper)); }
  }
</style>

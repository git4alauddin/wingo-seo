---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';
interface Props { title: string; description: string; type?: 'website' | 'article'; noindex?: boolean }
const { title, description, type, noindex } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><SEOHead title={title} description={description} type={type} noindex={noindex} /></head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>

---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { publishedGuides } from '../lib/guides';
interface Props { guide: CollectionEntry<'guides'>; headings: { depth: number; slug: string; text: string }[] }
const { guide, headings } = Astro.props;
const { data } = guide;
const all = await publishedGuides();
const related = data.related.map(slug => all.find(entry => entry.data.slug === slug)!);
const date = data.pubDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const cta = data.cta === 'simulator' ? { href: '/simulator/', label: 'Explore the simulator preview' } : { href: '/probability-calculator/', label: 'Explore the calculator preview' };
---
<BaseLayout title={data.title} description={data.description} type="article">
  <div class="container"><Breadcrumbs items={[{ label: 'Guides', href: '/guides/' }, { label: data.shortTitle }]} /></div>
  <header class="article-header container"><div class="article-meta"><span class="eyebrow">{data.topic}</span><span>{data.minutes} min read</span></div><h1>{data.title}</h1><p class="article-deck">{data.summary}</p><div class="publisher-line"><span class="publisher-mark" aria-hidden="true">ll</span><span>By {site.publisher}<span class="date-line">Published <time datetime={data.pubDate.toISOString()}>{date}</time></span></span></div></header>
  <div class="container article-layout">
    <aside class="article-sidebar"><nav aria-label="On this page"><span class="eyebrow">In this guide</span><ol>{headings.filter(h => h.depth === 2).map(h => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></nav><div class="sidebar-note"><Icon name="spark" /><strong>A model, made clear.</strong><p>Our calculations assume independent, equally likely digits from 0 to 9.</p></div></aside>
    <div class="article-main"><article class="prose"><div class="takeaway"><span class="eyebrow">The key idea</span><p>{data.takeaway}</p></div><slot /></article>
      <section class="sources" aria-labelledby="sources-title"><h2 id="sources-title">Sources & model notes</h2><p>These references support the concepts or document the selected example ruleset. Our worked examples are original.</p><ul>{data.sources.map(source => <li><a href={source.url} rel="noreferrer">{source.title} <span aria-hidden="true">↗</span></a></li>)}</ul></section>
      <section class="article-cta"><span class="eyebrow">Put the idea in context</span><h2>Make the numbers less abstract.</h2><p>See the model, its assumptions, and a worked example in our learning lab.</p><a class="button" href={cta.href}>{cta.label}<Icon /></a></section>
    </div>
  </div>
  <section class="section related-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">Keep your curiosity going</p><h2>Take the next step.</h2></div><a class="text-link" href="/guides/">All learning guides <Icon /></a></div><div class="article-grid">{related.map(entry => <ArticleCard guide={entry} />)}</div></div></section>
</BaseLayout>
